# Copy this file to .env and replace placeholder values.

POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me

# At least 32 bytes for HS256 JWT signing.
JWT_SECRET=change-me-to-a-long-random-secret

# JWT lifetime in minutes. Allowed range: 30-240 minutes.
JWT_EXPIRATION_MINUTES=60

# Set to true when using an AI profile (e.g. Gemini).
AI_ENABLED=false

# Required when AI_ENABLED=true.
AI_SERVICE_TOKEN=change-me-to-a-long-random-service-token

# Required when using the Gemini profile.
GEMINI_API_KEY=your-gemini-api-key
